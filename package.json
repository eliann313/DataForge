{
  "name": "dataforge",
  "version": "0.1.0",
  "private": true,
  "description": "DataForge — análisis de datos local-first en navegador. R1 cerrado; fase 4 en curso con pipelines locales.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "bench": "playwright test --config=playwright.bench.config.ts",
    "gen:bench": "node benchmarks/gen-csv.mjs",
    "smoke:static": "node scripts/smoke-static.mjs",
    "vendor:duckdb": "node scripts/vendor-duckdb.mjs",
    "postinstall": "npm run vendor:duckdb",
    "predev": "npm run vendor:duckdb",
    "prebuild": "npm run vendor:duckdb"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "@tailwindcss/postcss": "4.3.3",
    "@vercel/analytics": "^2.0.1",
    "echarts": "6.1.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.0",
    "read-excel-file": "9.3.12",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "fake-indexeddb": "6.2.5",
    "parquetjs-lite": "0.8.7",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=20.12 <25"
  }
}
